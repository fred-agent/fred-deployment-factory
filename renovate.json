{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The published release each k3d application deploys by default",
      "managerFilePatterns": ["/^k3d-apps/[^/]+/helmfile\\.yaml\\.gotmpl$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\{\\{- \\$pinned := \"(?<currentValue>[^\"]+)\" \\}\\}"
      ],
      "versioningTemplate": "semver"
    }
  ],
  "labels": ["release-pin"]
}
