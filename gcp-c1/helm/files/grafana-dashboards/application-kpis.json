    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "RAG search rate (total / error / empty), by status",
      "description": "rag.search_total, rag.search_error_total, rag.search_empty_total — status is the only surviving label on all three.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
