      "title": "API p95 latency, by route",
      "description": "api.request_latency_ms (histogram), emitted for every HTTP request to control-plane, knowledge-flow, and fred-agents alike. Surviving labels: route, method, status, http_status, error_code, exception_type.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 0, "y": 11, "w": 12, "h": 3 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{route}}",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "histogram_quantile(0.95, sum(rate(api_request_latency_ms_bucket[5m])) by (le, route))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "API error rate, by route",
      "description": "api.error_total ÷ api.request_latency_ms count — only non-2xx/3xx.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 12, "y": 11, "w": 12, "h": 3 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{route}}",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(rate(api_error_total[5m])) by (route) / sum(rate(api_request_latency_ms_count[5m])) by (route)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "API request rate, by route",
      "description": "api.request_latency_ms count, as a rate — overall traffic shape across control-plane, knowledge-flow and fred-agents.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 3 },
