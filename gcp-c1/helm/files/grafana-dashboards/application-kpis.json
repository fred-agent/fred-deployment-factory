  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Agent & tool execution",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Tool call p95 latency, by tool",
      "description": "agent.tool_latency_ms (histogram). Surviving labels: tool_name, template_agent_id.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 3 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{tool_name}}",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "histogram_quantile(0.95, sum(rate(agent_tool_latency_ms_bucket[5m])) by (le, tool_name))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tool failure rate, by tool",
      "description": "agent.tool_failed_total ÷ agent.tool_latency_ms count. Surviving labels: tool_name, template_agent_id, status, error_code, exception_type.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 3 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{tool_name}}",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(rate(agent_tool_failed_total[5m])) by (tool_name) / sum(rate(agent_tool_latency_ms_count[5m])) by (tool_name)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Agent turn completion rate, by template",
      "description": "agent.turn_completed (histogram, used here as a rate). Surviving labels: template_agent_id, runtime_id, model_name, finish_reason.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 3 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{template_agent_id}}",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(rate(agent_turn_completed_count[5m])) by (template_agent_id)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Agent turn error rate, by template",
      "description": "agent.turn_error_total ÷ agent.turn_completed count — only emitted when a turn errors.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 3 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{template_agent_id}}",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(rate(agent_turn_error_total[5m])) by (template_agent_id) / sum(rate(agent_turn_completed_count[5m])) by (template_agent_id)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Token throughput (input vs. output)",
      "description": "agent.turn_completed_quantity_{input,output}_tokens_total — this is where token counts actually live today, not any cost.* series (those have zero call sites).",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 3 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "input tokens/s",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(rate(agent_turn_completed_quantity_input_tokens_total[5m]))"
        },
        {
          "refId": "B",
          "legendFormat": "output tokens/s",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(rate(agent_turn_completed_quantity_output_tokens_total[5m]))"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "API & LLM calls",
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
