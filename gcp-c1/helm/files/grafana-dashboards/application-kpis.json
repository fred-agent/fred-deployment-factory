      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{route}}",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(rate(api_request_latency_ms_count[5m])) by (route)"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "LLM call latency p95, by model",
      "description": "llm.call_latency_ms (histogram). Only model_name survives as a label — agent_id and operation are sent but dropped.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 3 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
