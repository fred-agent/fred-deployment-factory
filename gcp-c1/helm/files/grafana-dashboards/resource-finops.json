        "text": { "valueSize": 20, "titleSize": 11 }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(kube_pod_container_resource_requests{resource=\"memory\"})"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Nodes over time (Autopilot scaling)",
      "description": "Each step is Autopilot adding or removing a node. Useful to correlate a scale-up with a load spike, a rollout, or a crash-loop (a broken pod that keeps restarting can itself trigger scale-ups).",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 3 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "node count",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "count(kube_node_info)"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Pods Pending over time",
      "description": "A brief spike (seconds to a few minutes) during a rollout or scale-up is normal — Autopilot is provisioning. A sustained plateau means something can't schedule (quota, a request bigger than any available machine shape, etc.) — worth a `kubectl describe pod`.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 3 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "pending pods",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(kube_pod_status_phase{phase=\"Pending\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU: requested vs. used",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "requested (cores)",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(kube_pod_container_resource_requests{resource=\"cpu\"})"
        },
        {
          "refId": "B",
          "legendFormat": "used (cores)",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\", container!=\"POD\"}[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory: requested vs. used",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "requested",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(kube_pod_container_resource_requests{resource=\"memory\"})"
        },
        {
          "refId": "B",
          "legendFormat": "used",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(container_memory_working_set_bytes{container!=\"\", container!=\"POD\"})"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pod restarts by namespace (hourly)",
      "description": "A rising trend here often shows up as wasted resource churn before it shows up anywhere else.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 3 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{namespace}}",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(increase(kube_pod_container_status_restarts_total[1h])) by (namespace)"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "Data volume (\"how much data do I actually have?\")",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "table",
      "title": "PostgreSQL — size per database",
      "description": "Read-only role (grafana_readonly): CONNECT + pg_read_all_stats only, no table access.",
      "datasource": { "type": "postgres", "uid": "postgres-grafana" },
      "gridPos": { "x": 0, "y": 17, "w": 12, "h": 4 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "size_bytes" }, "properties": [{ "id": "unit", "value": "bytes" }] }
        ]
      },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": { "type": "postgres", "uid": "postgres-grafana" },
          "rawSql": "SELECT datname AS database, pg_database_size(datname) AS size_bytes FROM pg_database WHERE datistemplate = false ORDER BY size_bytes DESC;"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "PostgreSQL — total size",
      "datasource": { "type": "postgres", "uid": "postgres-grafana" },
      "gridPos": { "x": 12, "y": 17, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "text": { "valueSize": 24, "titleSize": 13 }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "datasource": { "type": "postgres", "uid": "postgres-grafana" },
          "rawSql": "SELECT sum(pg_database_size(datname)) AS total_bytes FROM pg_database WHERE datistemplate = false;"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "GCS bucket size",
      "description": "Google Cloud Monitoring's own storage.googleapis.com/storage/total_bytes metric — collected automatically, ~5min granularity.",
      "datasource": { "type": "stackdriver", "uid": "cloud-monitoring" },
      "gridPos": { "x": 16, "y": 17, "w": 8, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "stackdriver", "uid": "cloud-monitoring" },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "fredlab-playground",
            "filters": ["metric.type", "=", "storage.googleapis.com/storage/total_bytes"],
            "groupBys": ["resource.label.bucket_name"],
            "crossSeriesReducer": "REDUCE_MEAN",
            "perSeriesAligner": "ALIGN_MEAN",
            "alignmentPeriod": "+3600s"
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "OpenSearch — size per index",
      "description": "Via the Infinity datasource hitting OpenSearch's own _cat/indices API directly — no exporter, no plugin data beyond the Infinity plugin itself.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "opensearch-infinity" },
      "gridPos": { "x": 0, "y": 21, "w": 16, "h": 4 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "size_bytes" }, "properties": [{ "id": "unit", "value": "bytes" }] }
        ]
      },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "opensearch-infinity" },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://opensearch:9200/_cat/indices?format=json&bytes=b",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "index", "text": "index", "type": "string" },
            { "selector": "health", "text": "health", "type": "string" },
            { "selector": "docs.count", "text": "docs", "type": "number" },
            { "selector": "store.size", "text": "size_bytes", "type": "number" }
