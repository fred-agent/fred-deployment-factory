  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Capacity & headroom (\"do I have room for more?\")",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "CPU requested / allocatable",
      "description": "Autopilot bills by requested CPU, not used CPU, and expands allocatable on demand — so this ratio is a point-in-time capacity/scheduling signal, not a health check. Blue at >=90% just means Autopilot is packed tight right now; it self-corrects as soon as a new node joins. For an actual growth/cost trend, watch the FinOps absolute-value panels below instead — this ratio resets every time capacity grows.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 2 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "blue", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "text": { "valueSize": 20, "titleSize": 11 }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(kube_pod_container_resource_requests{resource=\"cpu\"}) / sum(kube_node_status_allocatable{resource=\"cpu\"}) * 100"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Memory requested / allocatable",
      "description": "Same as CPU: this is the request-vs-capacity number that determines whether a new pod can schedule right now, not a growth trend — Autopilot expands allocatable to match, so the ratio self-corrects after every scale-up. Blue at >=90% = tightly packed, not an outage. Use the FinOps absolute-value panels below to track real growth.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 2 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "blue", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "text": { "valueSize": 20, "titleSize": 11 }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(kube_pod_container_resource_requests{resource=\"memory\"}) / sum(kube_node_status_allocatable{resource=\"memory\"}) * 100"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CPU overprovisioning (requested ÷ used)",
      "description": "FinOps signal, not a health check. Green = safe (using at or under what's requested — the normal, expected state here, even if it costs more than strictly needed). Red = actually using MORE than requested, a real capacity-risk signal worth a look.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 2 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "text": { "valueSize": 20, "titleSize": 11 }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(kube_pod_container_resource_requests{resource=\"cpu\"}) / sum(rate(container_cpu_usage_seconds_total{container!=\"\", container!=\"POD\"}[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Memory overprovisioning (requested ÷ used)",
      "description": "Same FinOps signal for memory, not a health check. Green = safe (using at or under what's requested). Red = actually using MORE than requested, a real capacity-risk signal (possible OOM risk if it also nears the container's memory limit).",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 2 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "text": { "valueSize": 20, "titleSize": 11 }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(kube_pod_container_resource_requests{resource=\"memory\"}) / sum(container_memory_working_set_bytes{container!=\"\", container!=\"POD\"})"
        }
      ]
    },
    {
      "id": 26,
      "type": "row",
      "title": "Autopilot behavior & FinOps budget (\"is Autopilot keeping up, and am I growing beyond a playground?\")",
      "gridPos": { "x": 0, "y": 3, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Pods Pending (current)",
      "description": "0 = everything is scheduled. >0 = Autopilot is provisioning a node for you — normal for a few minutes during a rollout or scale-up. If it stays orange for more than ~5 minutes, check the 'Pods Pending over time' panel and `kubectl describe pod` for FailedScheduling events.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 0, "y": 4, "w": 6, "h": 2 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "text": { "valueSize": 20, "titleSize": 11 }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(kube_pod_status_phase{phase=\"Pending\"})"
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Nodes (current)",
      "description": "Autopilot node count. Every extra node is a direct cost increment. Thresholds are a playground budget guess (~4 nodes baseline as of 2026-07-18) — tighten or loosen to match what you actually expect to pay for.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 6, "y": 4, "w": 6, "h": 2 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 6 },
              { "color": "red", "value": 8 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "text": { "valueSize": 20, "titleSize": 11 }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "count(kube_node_info)"
        }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "CPU requested (FinOps budget, absolute)",
      "description": "Absolute cores requested cluster-wide — NOT a ratio, so it doesn't self-correct when Autopilot adds capacity. This is the real 'am I getting more traffic than a playground should' signal. Thresholds are a starting guess (~19 cores baseline as of 2026-07-18) — adjust to your actual budget.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 12, "y": 4, "w": 6, "h": 2 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 24 },
              { "color": "red", "value": 32 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "text": { "valueSize": 20, "titleSize": 11 }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "gmp" },
          "expr": "sum(kube_pod_container_resource_requests{resource=\"cpu\"})"
        }
      ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Memory requested (FinOps budget, absolute)",
      "description": "Absolute memory requested cluster-wide — NOT a ratio, so it doesn't self-correct when Autopilot adds capacity. Thresholds are a starting guess (80Gi/110Gi, scaled from the CPU budget using this cluster's ~1:3.5 core:memory node shape) — adjust to your actual budget.",
      "datasource": { "type": "prometheus", "uid": "gmp" },
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 2 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
