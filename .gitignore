# Local Docker Compose configuration
/docker-compose/.env

# Python/dev tooling
/.venv/
/bin/.venv/
**/__pycache__/
*.pyc
**/*.egg-info/

# Terraform local state
**/.terraform/
*.tfstate
*.tfstate.*

# Local secrets/helpers (unencrypted)
key.txt
key-int.txt
key-prod.txt
*.nosec.yaml
*.secrets.values.yaml
fredlab-secrets.values.yaml
helm/**/fredlab-secrets.values.yaml
helm/**/fredlab-secrets.values.yaml.*

# Checkpoint snapshots (Docker volume archives — can be large)
/checkpoints/

# Migration rehearsal dumps (identity = user data, data = document binaries — sensitive, can be large)
/dumps/

# Generated empty realm template (SEED_DEMO=false) — derived from app-realm.json.template
/docker-compose/keycloak/app-realm.empty.json.template

# Editor and OS artifacts
.DS_Store
.vscode/
.idea/
*.swp
