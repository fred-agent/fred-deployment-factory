# Local Docker Compose configuration
/docker/.env

# Python/dev tooling
/.venv/
/bin/.venv/
**/__pycache__/
*.pyc
**/*.egg-info/

# Terraform local state
**/.terraform/
*.tfstate
*.tfstate.*

# Local secrets/helpers (unencrypted)
key.txt
key-int.txt
key-prod.txt
*.nosec.yaml
*.secrets.values.yaml
fredlab-secrets.values.yaml
gcp-c1/helm/**/fredlab-secrets.values.yaml
gcp-c1/helm/**/fredlab-secrets.values.yaml.*
# Real user roster for bin/fredlab-keycloak-provision-users.sh — names,
# emails, temporary passwords. Never git-tracked; see
# config/fredlab-keycloak-identity.example.json for the shape.
config/fredlab-keycloak-identity.json
config/fredlab-keycloak-identity.local.json

# Real team/role bundle for Fred's declarative import (DEPLOY-CLOUD.md §5.2)
# — real names/emails, no passwords, never git-tracked.
/config/fredlab-platform-import/
/config/fredlab-platform-import*.zip

# Checkpoint snapshots (Docker volume archives — can be large)
/checkpoints/

# Retired: `make keycloak-up` no longer generates this file (the canonical
# app-realm.json.template is now itself empty). Keep ignored in case a stale
# local copy from an older checkout still exists on disk.
/docker/keycloak/app-realm.empty.json.template

# Editor and OS artifacts
.DS_Store
.vscode/
.idea/
*.swp
