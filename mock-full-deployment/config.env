# Paramètres non secrets de la maquette. Les secrets sont dans secrets/ (non versionné).

# --- Sources ---------------------------------------------------------------
# Dépôt Fred (branche feat/use-keycloack-only-as-an-idp) : configurations de base.
FRED_REPO=/home/thomas/Documents/fred
# Fichier produit par le kit Entra (méthode A ou B du GUIDE-ENTRA-ID.md).
ENTRA_ENV=/home/thomas/Documents/fred-deployments/test-entra-perso/secrets/entra.env
# Python qui dispose de pyyaml et jsonschema (celui d'un venv Fred suffit).
PYTHON=/home/thomas/Documents/fred/apps/knowledge-flow-backend/.venv/bin/python

# --- Réseau simulé ("LAN client") -------------------------------------------
LAN_SUBNET=10.89.10.0/24
DOMAIN=fred.lan
REGISTRY_IP=10.89.10.5
STO_IP=10.89.10.11
APP_IP=10.89.10.21
STO_FQDN=fred-sto-01.fred.lan
APP_FQDN=fred-app-01.fred.lan
# Réseau podman interne de fred-app-01 (pas sur le LAN) : sous-réseau fixe pour que
# Temporal ait une IP stable, annoncée dans etc/fred/temporal/temporal.yaml.
APP_PODMAN_SUBNET=10.89.250.0/24
TEMPORAL_IP=10.89.250.10
REGISTRY_HOST=registry.fred.lan:5000

# --- Accès navigateur -----------------------------------------------------
# http://localhost:5173/ est déjà déclaré comme redirect URI SPA de "Fred UI"
# dans le kit Entra : garder ce port évite toute modification côté Entra.
PUBLIC_PORT=5173
PUBLIC_URL=http://localhost:5173

# --- Image de base des VMs (RHEL 9) -----------------------------------------
# UBI 9 init = binaires RHEL 9 + systemd. Repli possible si le CDN Red Hat est
# inaccessible : docker.io/redhat/ubi9-init:latest (même image, Docker Hub).
VM_BASE_IMAGE=registry.access.redhat.com/ubi9/ubi-init:latest

# --- Stockage objet ---------------------------------------------------------
S3_ACCESS_KEY=fred-app

# UID du processus postgres dans l'image Postgres (70 pour images/postgres ;
# 999 pour pgvector/pgvector). Propriétaire des données et de la clé TLS.
PG_UID=70
# UID du processus weed dans l'image SeaweedFS (65532 pour images/seaweedfs ;
# 1000 pour chrislusf/seaweedfs) : il doit pouvoir lire la clé TLS, sinon la
# poignée de main HTTPS reste bloquée.
SEAWEED_UID=65532
