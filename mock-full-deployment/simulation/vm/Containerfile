# "VM" RHEL 9 simulée : systemd en PID 1 + podman rootful + podman-compose.
# Elle ne contient rien de Fred : le bundle est livré ensuite dans /opt/fred,
# /etc/fred et /var/lib/fred, comme le ferait l'exploitant du client.
ARG VM_BASE_IMAGE=registry.access.redhat.com/ubi9/ubi-init:latest
FROM ${VM_BASE_IMAGE}

RUN dnf -y install podman python3-pip openssl iproute procps-ng hostname less \
    && dnf clean all \
    && pip3 install --no-cache-dir 'podman-compose>=1.3,<2'

COPY registries.conf /etc/containers/registries.conf.d/50-fred-mirror.conf
COPY containers.conf /etc/containers/containers.conf.d/50-fred.conf

# Arborescence standard Fred sur les VMs (voir README, "Chemins dans les VMs").
RUN mkdir -p /opt/fred /etc/fred /var/lib/fred \
    && systemctl mask systemd-logind.service getty.target console-getty.service

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
