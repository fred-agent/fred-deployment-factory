      "enabled": true,
      "emailVerified": true,
      "appRoles": [
        "viewer"
      ],
      "teams": [
        "Innovation"
      ],
      "teamRoles": {
        "owner": [
          "Innovation"
        ]
      }
    },
    {
      "email": "engineering.owner@example.com",
      "firstName": "Engineering",
      "lastName": "Owner",
