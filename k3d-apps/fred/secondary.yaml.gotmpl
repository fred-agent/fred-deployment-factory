# Fred alone in the second cluster (registrations.yaml.gotmpl registers nothing there).
# The default Swift values remain unchanged.
x-security: &security
  m2m:
    realm_url: {{ requiredEnv "K3D_REALM_URL" | quote }}
  user:
    realm_url: {{ requiredEnv "K3D_REALM_URL" | quote }}
  authorized_origins:
    - {{ requiredEnv "K3D_PUBLIC_URL" | quote }}

applications:
  frontend:
    configuration:
      config_json:
        backend_url_api: {{ requiredEnv "K3D_PUBLIC_URL" | quote }}
        backend_url_knowledge: {{ requiredEnv "K3D_PUBLIC_URL" | quote }}
        websocket_url: {{ printf "%s/fred/chatbot/query" (requiredEnv "K3D_WEBSOCKET_URL") | quote }}

  fred-agents:
    configuration:
      security: *security

  knowledge-flow-backend:
    configuration:
      security: *security

  knowledge-flow-worker:
    configuration:
      security: *security

  control-plane-backend:
    configuration:
      security: *security
      platform:
        frontend:
          feature_flags:
            enableApplications: false

  control-plane-worker:
    configuration:
      security: *security
