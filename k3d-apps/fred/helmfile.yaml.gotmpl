# Fred on this k3d instance: `make k3d-app APP=fred [RELEASE=<version>] [DIR=<fred checkout>]`.
# Without DIR, the published chart and images, at RELEASE or the version pinned
# below (bumped by a Renovate PR after each Fred release). With DIR, the checkout's chart, and
# K3D_IMAGE_VALUES selects the images its deploy/k3d/build made.
# renovate: datasource=docker depName=ghcr.io/thalesgroup/fred-helm/fred
{{- $pinned := "3.8.0" }}
{{- $checkout := env "K3D_APP_CHECKOUT" }}
releases:
  - name: fred-app
    {{- if $checkout }}
    chart: {{ printf "%s/deploy/charts/fred" $checkout | quote }}
    {{- else }}
    chart: oci://ghcr.io/thalesgroup/fred-helm/fred
    version: {{ env "RELEASE" | default $pinned | quote }}
    {{- end }}
    values:
      - values.yaml
      {{- with env "K3D_IMAGE_VALUES" }}
      - {{ . | quote }}
      {{- end }}
