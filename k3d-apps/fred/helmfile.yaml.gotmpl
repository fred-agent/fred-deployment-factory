# Fred on this k3d instance, one environment per Fred release line:
#   helmfile -f k3d-apps/fred/helmfile.yaml.gotmpl -e swift sync
# Without DIR, the published chart and images, at RELEASE or the version pinned below
# (bumped by a Renovate PR after each Fred release). With DIR, the checkout's chart, and
# K3D_IMAGE_VALUES selects the images its deploy/k3d/build made (make k3d-app does both).
environments:
  swift:
    values:
      - checkoutMarker: apps/control-plane-backend/pyproject.toml
        # renovate: datasource=docker depName=ghcr.io/thalesgroup/fred-helm/fred
        pinned: "3.11.1"
  weaver:
    values:
      - checkoutMarker: apps/control-plane/Cargo.toml
        pinned: ""     # Published from Fred 5.0.0.
---
{{- $checkout := env "DIR" }}
{{- $version := env "RELEASE" | default .Values.pinned }}
{{- $preparation := false }}
{{- if and $checkout (not (isFile (printf "%s/%s" $checkout .Values.checkoutMarker))) }}
{{- fail (printf "DIR=%s is not a checkout of Fred %s (it has no %s)" $checkout .Environment.Name .Values.checkoutMarker) }}
{{- end }}
{{- if not (or $checkout $version) }}
{{- fail (printf "FRED=%s has no published release yet: use DIR=/path/to/%s/fred" .Environment.Name .Environment.Name) }}
{{- end }}
{{- if and (eq .Environment.Name "swift") $checkout }}
{{- $chartValues := readFile (printf "%s/deploy/charts/fred/values.yaml" $checkout) }}
{{- $preparation = regexMatch "(?m)^  fred-agents-preparation-worker:" $chartValues }}
{{- end }}
{{- if and (eq (env "K3D_PPT_PREPARATION") "true") (not $preparation) }}
{{- fail "K3D_PPT_PREPARATION=true requires FRED=swift and a Fred checkout with the preparation worker" }}
{{- end }}
helmDefaults:
  kubeContext: k3d-fred
  wait: true
  waitForJobs: true
  timeout: 1200
  historyMax: 10

releases:
  - name: fred-app
    namespace: fred-{{ .Environment.Name }}
    {{- if $checkout }}
    chart: {{ printf "%s/deploy/charts/fred" $checkout | quote }}
    {{- else }}
    chart: oci://ghcr.io/thalesgroup/fred-helm/fred
    version: {{ $version | quote }}
    {{- end }}
    values:
      - values-{{ .Environment.Name }}.yaml
      {{- if $preparation }}
      - preparation.yaml.gotmpl
      {{- end }}
      {{- with env "K3D_IMAGE_VALUES" }}
      - {{ . | quote }}
      {{- end }}
      {{- if and (eq .Environment.Name "swift") (not $checkout) (ne (env "K3D_PYMUPDF") "false") }}
      - pymupdf.yaml
      - applications:
          knowledge-flow-backend:
            image:
              tag: "v{{ $version }}"
          knowledge-flow-worker:
            image:
              tag: "v{{ $version }}"
      {{- end }}
    hooks:
      # The model keys are the operator's, created before deploying, as in production
      # (on Weaver, make k3d-app creates them from MISTRAL_API_KEY/OPENAI_API_KEY).
      # Without them the pods would wait until the sync times out.
      - events: [presync]
        showlogs: true
        command: kubectl
        args: [--context, k3d-fred, --namespace, "fred-{{ .Environment.Name }}", get, secret, fred-model-credentials, --output, name]
