# Applied only when the selected Fred checkout contains the preparation worker.
# Keep PPT cutover off until existing templates have been backfilled.
{{- $cutover := eq (env "K3D_PPT_PREPARATION") "true" }}
applications:
  fred-agents:
    configuration:
      preparation:
        enabled_capabilities: {{ if $cutover }}[ppt_builder]{{ else }}[]{{ end }}

  fred-agents-preparation-worker:
    enabled: true
    deployment:
      enabled: true

  control-plane-backend:
    configuration:
      platform:
        runtime_catalog_sources:
          - runtime_id: fred-agents
            base_url: http://fred-agents/fred/agents/v2
            enabled: true
            ingress_prefix: /fred/agents/v2
            preparation_client_id: agentic
            preparation_enabled: {{ $cutover }}
