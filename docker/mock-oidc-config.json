{
  "interactiveLogin": true,
  "tokenCallbacks": [
    {
      "issuerId": "fred",
      "tokenExpiry": 5400,
      "requestMappings": [
        {
          "requestParam": "client_id",
          "match": "agentic",
          "claims": {
            "sub": "${clientId}",
            "aud": [
              "fred-api"
            ],
            "azp": "${clientId}",
            "roles": [
              "service_agent",
              "delegation_caller"
            ]
          }
        },
        {
          "requestParam": "client_id",
          "match": "knowledge-flow",
          "claims": {
            "sub": "${clientId}",
            "aud": [
              "fred-api"
            ],
            "azp": "${clientId}",
            "roles": [
              "service_agent"
            ]
          }
        },
        {
          "requestParam": "client_id",
          "match": "control-plane",
          "claims": {
            "sub": "${clientId}",
            "aud": [
              "fred-api"
            ],
            "azp": "${clientId}",
            "roles": [
              "service_agent"
            ]
          }
        },
        {
          "requestParam": "subject",
          "match": ".*",
          "claims": {
            "aud": [
              "fred-api"
            ],
            "azp": "${clientId}",
            "preferred_username": "${subject}"
          }
        },
        {
          "requestParam": "client_id",
          "match": ".*",
          "claims": {
            "aud": [
              "fred-api"
            ],
            "azp": "${clientId}"
          }
        }
      ]
    }
  ]
}
