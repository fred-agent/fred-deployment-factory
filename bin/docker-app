#!/usr/bin/env bash
# Run Fred from a checkout against the Docker Compose services: what a developer would
# type, in order, as bin/k3d-app does on k3d. From make docker-app.
# FRED: the line, weaver only on Docker Compose. APP: fred. DIR: a Weaver checkout.
# KEY_FILE: a file holding only the Mistral API key, as for k3d's fred-model-credentials.
set -Eeuo pipefail

fail() { printf '%s\n' "$1" >&2; exit 1; }

[[ -n "${FRED:-}" ]] || fail "FRED is required: make docker-app FRED=weaver APP=fred DIR=/path/to/fred"
[[ "$FRED" == weaver ]] || fail "Docker Compose runs Fred weaver only; Swift on Docker Compose is on branch swift"
[[ "${APP:-}" == fred ]] || fail "APP=fred is the only application on Docker Compose"
[[ -n "${DIR:-}" ]] || fail "DIR is required, a checkout: make docker-app FRED=$FRED APP=fred DIR=/path/to/fred"
[[ -d "$DIR" ]] || fail "DIR=$DIR: no such directory"
DIR="$(cd "$DIR" && pwd)"
[[ -f "$DIR/apps/control-plane/Cargo.toml" ]] || fail "DIR=$DIR is not a checkout of Fred $FRED (it has no apps/control-plane/Cargo.toml)"
[[ "$(docker inspect -f '{{.State.Health.Status}}' app-postgres 2>/dev/null)" == healthy ]] \
  || fail "The Docker Compose services are not running: make docker-up first"
if [[ -n "${KEY_FILE:-}" ]]; then
  [[ -f "$KEY_FILE" ]] || fail "KEY_FILE=$KEY_FILE: no such file"
  KEY_FILE="$(realpath "$KEY_FILE")"
fi

make -C "$DIR" setup-env ${KEY_FILE:+KEY_FILE="$KEY_FILE"}
# The model key is the developer's, as on k3d: without it Fred starts but cannot answer.
grep -qE '^OPENAI_API_KEY="?[^"]+' "$DIR/apps/fred-agents/config/.env" \
  || fail "No Mistral API key yet: add KEY_FILE=/path/to/key-file, a file holding only the key"
make -C "$DIR" docker-prepare

printf '\nFRED=%s, Docker Compose: http://localhost:5173\n' "$FRED"
printf 'First login, the bootstrap token: grep FRED_BOOTSTRAP_TOKEN %s/apps/control-plane/config/.env\n\n' "$DIR"
exec make -C "$DIR" run
