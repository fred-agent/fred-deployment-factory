#!/usr/bin/env bash
# Deploy one application in its Helmfile environment.
#   bin/k3d-app sync|template|destroy     (from make k3d-app, k3d-app-validate, k3d-app-uninstall)
# FRED: a Helmfile environment. APP: a definition in k3d-apps/. DIR: a checkout;
# without APP, one holding its own deploy/k3d/helmfile.yaml.gotmpl. RELEASE: a published
# version instead. VALUES: extra values files. FRED_LIBS, FRED_REPO: for the checkout's build.
set -Eeuo pipefail

action="${1:?usage: bin/k3d-app sync|template|destroy}"
root="$(cd "$(dirname "$0")/.." && pwd)"
fail() { printf '%s\n' "$1" >&2; exit 1; }

[[ -n "${FRED:-}" ]] || fail "FRED is required: choose an environment declared by the application's Helmfile (swift, weaver, or a standalone app's bench)"
[[ -n "${APP:-}${DIR:-}" ]] || fail "APP or DIR is required: make k3d-app FRED=$FRED APP=fred [DIR=/path/to/checkout | RELEASE=version]"
[[ -z "${DIR:-}" || -z "${RELEASE:-}" ]] || fail "RELEASE deploys a published release and DIR a checkout: choose one"
if [[ -n "${DIR:-}" ]]; then
  [[ -d "$DIR" ]] || fail "DIR=$DIR: no such directory"
  DIR="$(cd "$DIR" && pwd)"
  export DIR
fi

if [[ -n "${APP:-}" ]]; then definition="$root/k3d-apps/$APP"
elif [[ -f "$DIR/deploy/k3d/helmfile.yaml.gotmpl" ]]; then definition="$DIR/deploy/k3d"
else definition="$DIR"; fi
[[ -f "$definition/helmfile.yaml.gotmpl" ]] || fail "No helmfile.yaml.gotmpl in $definition"

key="$(printf '%s' "${DIR:-published}" | sha256sum | cut -c1-12)"
export K3D_APP_OUT="$root/.cache/k3d-apps/$FRED/${APP:-$(basename "$definition")}-$key"
mkdir -p "$K3D_APP_OUT"
images="$K3D_APP_OUT/images.yaml"

helmfile=(helmfile --file "$definition/helmfile.yaml.gotmpl" --environment "$FRED")
value_files=()
for file in ${VALUES:-}; do value_files+=("$(realpath "$file")"); done
export VALUES="${value_files[*]}"
values=()
# Fred's Helmfile renders values templates; standalone apps receive plain YAML.
if [[ "${APP:-}" != fred ]]; then
  for file in "${value_files[@]}"; do values+=(--values "$file"); done
fi
[[ -n "${DIR:-}" && -f "$images" ]] && export K3D_IMAGE_VALUES="$images"

if [[ "$action" == sync && "${APP:-}" == fred && " ${value_files[*]} " != *" $root/k3d-apps/fred/models-mock.yaml.gotmpl "* ]]; then
  # Helm records the opt-in. Omission must not silently remove a registered source.
  retained="$(helm --kube-context k3d-fred -n "fred-$FRED" list -o json --filter '^fred-app$')"
  if [[ "$retained" != '[]' ]]; then
    previous="$(helm --kube-context k3d-fred -n "fred-$FRED" get values fred-app -o json)"
    if python3 -c 'import json,sys; a=(json.load(sys.stdin) or {}).get("applications", {}); sources=a.get("control-plane-backend", {}).get("configuration", {}).get("platform", {}).get("model_sources", []); profiles=a.get("fred-agents", {}).get("models_catalog", {}).get("profiles", []); sys.exit(not (any(x.get("source_id")=="bench-mock" for x in sources) or any(x.get("profile_id")=="bench.chat.mock" for x in profiles)))' <<<"$previous"; then
      fail "This release uses the benchmark model. Keep k3d-apps/fred/models-mock.yaml.gotmpl in VALUES; removing its source requires a deliberate model migration."
    fi
  fi
fi

if [[ "$action" != destroy ]]; then
  # A mistake costs seconds here, not a build.
  "${helmfile[@]}" template "${values[@]}" >/dev/null \
    || fail "Cannot render this for FRED=$FRED (see above). $definition/helmfile.yaml.gotmpl lists its supported environments."
fi
[[ "$action" == template ]] && { echo "Rendered for FRED=$FRED, without building or changing the cluster."; exit 0; }

# Weaver's model keys are the developer's exported ones, as on Docker Compose: each one
# becomes a key of fred-model-credentials. Without any, the secret must already exist.
if [[ "$action" == sync && "$FRED" == weaver && -n "${MISTRAL_API_KEY:-}${OPENAI_API_KEY:-}" ]]; then
  keys="$(mktemp)"; trap 'rm -f "$keys"' EXIT; chmod 600 "$keys"
  for name in MISTRAL_API_KEY OPENAI_API_KEY; do
    if [[ -n "${!name:-}" ]]; then printf '%s=%s\n' "$name" "${!name}" >>"$keys"; fi
  done
  kubectl --context k3d-fred -n fred-weaver create secret generic fred-model-credentials \
    --from-env-file="$keys" --dry-run=client -o yaml | kubectl --context k3d-fred apply -f - >/dev/null
  echo "fred-model-credentials: $(cut -d= -f1 "$keys" | paste -sd, -) from the shell"
fi

if [[ "$action" == sync && -n "${DIR:-}" && -x "$DIR/deploy/k3d/build" ]]; then
  IMAGE_TAG="k3d-fred-$key" "$DIR/deploy/k3d/build"
  mapfile -t built <"$K3D_APP_OUT/images.txt"
  k3d image import --cluster fred "${built[@]}"
  export K3D_IMAGE_VALUES="$images"
fi

if [[ "$action" == sync ]]; then "${helmfile[@]}" sync "${values[@]}"; else "${helmfile[@]}" "$action"; fi

# A checkout's deploy/grafana/*.json go to the stack's Grafana (folder Fred); a published
# release ships none. Made for the Import page, they name the data source ${DS_PROMETHEUS}:
# file provisioning resolves no input, so it becomes the uid of the stack's Prometheus.
if [[ "$action" == sync && "${APP:-}" == fred && -n "${DIR:-}" ]] && compgen -G "$DIR/deploy/grafana/*.json" >/dev/null \
    && kubectl --context k3d-fred -n fred-infra get deployment grafana >/dev/null 2>&1; then
  dashboards="$(mktemp -d)"
  for f in "$DIR"/deploy/grafana/*.json; do
    sed 's/\${DS_PROMETHEUS}/prometheus/g' "$f" >"$dashboards/$(basename "$f")"
  done
  cm=(kubectl --context k3d-fred -n fred-infra get configmap grafana-dashboards -o jsonpath='{.data}')
  before="$( { "${cm[@]}" 2>/dev/null || true; } | sha256sum)"
  kubectl --context k3d-fred -n fred-infra create configmap grafana-dashboards --from-file="$dashboards" \
    --dry-run=client -o yaml | kubectl --context k3d-fred apply -f - >/dev/null
  rm -rf "$dashboards"
  # Grafana started before the ConfigMap existed never sees it (an optional volume is not
  # filled in later): restart it whenever the dashboards change.
  if [[ "$("${cm[@]}" | sha256sum)" != "$before" ]]; then
    kubectl --context k3d-fred -n fred-infra rollout restart deployment/grafana >/dev/null
    kubectl --context k3d-fred -n fred-infra rollout status deployment/grafana --timeout 300s >/dev/null
  fi
  echo "Grafana dashboards from $DIR/deploy/grafana: http://localhost:3002 (folder Fred)"
fi

if [[ "$action" == sync ]]; then
  printf '\nDeployed FRED=%s, namespace fred-%s.\n' "$FRED" "$FRED"
  if [[ "${APP:-}" == fred ]]; then
    printf 'Fred: http://%s.localhost:8088\n' "$FRED"
    printf 'First login, the bootstrap token: kubectl --context k3d-fred -n fred-%s get secret fred-secrets -o jsonpath="{.data.CONTROL_PLANE_BOOTSTRAP_TOKEN}" | base64 -d; echo\n' "$FRED"
  fi
fi
