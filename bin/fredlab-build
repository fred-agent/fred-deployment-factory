#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
CATALOG="${IMAGE_CATALOG:-${REPO_ROOT}/config/fredlab-images.tsv}"

# The four app-layer images ArgoCD (fred-apps) deploys. `all` builds exactly these
# at one tag — the knowledge-flow worker reuses knowledge-flow-backend, so 4 builds
# cover all 5 workloads. Evaluation / dt-agents / fred-samples are NOT app-layer and
# are built by name on purpose.
APP_LAYER=(control-plane-backend frontend fred-agents knowledge-flow-backend)

usage() {
  cat <<'EOF'
Usage:
  bin/fredlab-build list
  bin/fredlab-build all <tag>
  bin/fredlab-build <name> [tag]

Examples:
  bin/fredlab-build all 20260626-swift-3edab4ee
  bin/fredlab-build frontend 0.2
  bin/fredlab-build control-plane-backend 0.2
  bin/fredlab-build fred-agents 0.2

`all` builds the four ArgoCD app-layer images at one tag:
  control-plane-backend frontend fred-agents knowledge-flow-backend
The image catalog is config/fredlab-images.tsv.
EOF
}

expand_path() {
  local value="$1"
  case "${value}" in
    ""|"\$FRED_REPO_DIR")
      # The monorepo. SINGLE source of truth = the FRED_REPO_DIR env (default ~/fred),
      # the exact same knob bin/fredlab-release.sh uses for the tag — so the built
      # source and the tag can never point at different checkouts. Relocate your
      # monorepo? Set FRED_REPO_DIR; touch nothing here.
      printf '%s\n' "${FRED_REPO_DIR:-${HOME}/fred}"
      ;;
    "~")
      printf '%s\n' "${HOME}"
      ;;
    "~/"*)
      printf '%s/%s\n' "${HOME}" "${value#~/}"
      ;;
    "\$HOME/"*)
      printf '%s/%s\n' "${HOME}" "${value#\$HOME/}"
      ;;
    *)
      printf '%s\n' "${value}"
      ;;
  esac
}

list_images() {
  printf '%-28s %-32s %-28s %s\n' "NAME" "IMAGE" "REPO_DIR" "DOCKERFILE"
  while IFS=$'\t' read -r name image repo_dir dockerfile build_context; do
    [[ -z "${name}" || "${name}" == \#* ]] && continue
    printf '%-28s %-32s %-28s %s\n' "${name}" "${image}" "${repo_dir}" "${dockerfile}"
  done < "${CATALOG}"
}

build_one() {
  local target_name="$1" tag="$2" found=0
  while IFS=$'\t' read -r name image repo_dir dockerfile build_context; do
    [[ -z "${name}" || "${name}" == \#* ]] && continue
    [[ "${name}" != "${target_name}" ]] && continue
    found=1

    FRED_REPO_DIR="$(expand_path "${repo_dir}")" \
    IMAGE="${image}" \
    DOCKERFILE="${dockerfile}" \
    BUILD_CONTEXT="${build_context:-.}" \
    TAG="${tag}" \
    "${SCRIPT_DIR}/fredlab-build-image.sh"
    break
  done < "${CATALOG}"

  if [[ "${found}" != "1" ]]; then
    echo "Unknown image name: ${target_name}"
    echo
    list_images
    return 1
  fi
}

if [[ ! -f "${CATALOG}" ]]; then
  echo "Missing image catalog: ${CATALOG}"
  exit 1
fi

COMMAND="${1:-}"
case "${COMMAND}" in
  ""|-h|--help)
    usage
    exit 0
    ;;
  list)
    list_images
    exit 0
    ;;
  all)
    TAG="${2:-${TAG:-}}"
    if [[ -z "${TAG}" ]]; then
      echo "Usage: bin/fredlab-build all <tag>"
      exit 1
    fi
    for name in "${APP_LAYER[@]}"; do
      echo "=== building ${name}:${TAG} ==="
      build_one "${name}" "${TAG}"
    done
    echo "Built all app-layer images at ${TAG}."
    exit 0
    ;;
esac

build_one "${COMMAND}" "${2:-${TAG:-}}"
