#!/usr/bin/env bash
# Prepare a Fred Weaver checkout to run on the host against the Docker Compose services,
# as k3d's install hooks do for a deployment. Starts nothing. From make docker-prepare.
# DIR: a Weaver checkout. The model keys are the developer's, exported in the shell:
# MISTRAL_API_KEY and/or OPENAI_API_KEY, the destinations Fred's configurations attest.
set -Eeuo pipefail

fail() { printf '%s\n' "$1" >&2; exit 1; }

[[ -n "${DIR:-}" ]] || fail "DIR is required, a Fred Weaver checkout: make docker-prepare DIR=/path/to/fred"
[[ -d "$DIR" ]] || fail "DIR=$DIR: no such directory"
DIR="$(cd "$DIR" && pwd)"
[[ -f "$DIR/apps/control-plane/Cargo.toml" ]] || fail "DIR=$DIR is not a Fred Weaver checkout (it has no apps/control-plane/Cargo.toml)"
[[ "$(docker inspect -f '{{.State.Health.Status}}' weaver-app-postgres 2>/dev/null)" == healthy ]] \
  || fail "The Docker Compose services are not running: make docker-up first"

# setup-env copies each exported key and refuses to continue without any.
make -C "$DIR" setup-env
make -C "$DIR" docker-prepare

token="$(sed -n -E 's/^FRED_BOOTSTRAP_TOKEN="?([^"]+)"?$/\1/p' "$DIR/apps/control-plane/config/.env")"
cat <<MESSAGE

✓ Fred is prepared; nothing runs yet.

Start Fred, one of:
  - everything in one terminal:   make -C $DIR run
  - one component per terminal:   make -C $DIR/apps/<component> run
      control-plane, knowledge-flow-backend, knowledge-flow-worker, fred-agents, frontend,
      and the capability worker:  make -C $DIR/apps/fred-agents run-worker
  - or ask your coding assistant to start Fred.

First login, once Fred runs:
  1. Open http://localhost:5173 and register: the realm starts empty.
  2. Paste this bootstrap token when Fred asks for it, then accept the terms:
       $token
  3. Continue with Fred's first start: $DIR/deploy/k3d/README.md#first-start
MESSAGE
